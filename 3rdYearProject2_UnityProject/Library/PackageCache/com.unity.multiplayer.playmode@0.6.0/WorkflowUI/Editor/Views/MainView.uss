MainView {
    flex-grow: 20;
    font-size: 11.5px;
    margin: 6px;
    padding-right: 10px;
}

#ScrollView {
    display: flex;
    flex-direction: column;
    flex-grow: 20;
}

.spacer {
    margin-top: -9px;
}

#MainListView {
    margin-bottom: 20px;
}

#VirtualListView {
    margin-bottom: 20px;
}

.header {
    -unity-font-style: bold;
    padding: 0 0 4px 4px;
}

#VirtualPlayersLabel{
    margin-bottom: 10px;
}

#BuildErrorMessage {
    display: none;
}

.hasCompileErrors #BuildErrorMessage {
    display: flex;
}

#NoMPPMMessage {
    display: none;
}

.hasMPPMDisabled #NoMPPMMessage {
    display: flex;
}

#BuildErrorMessage2 {
    display: none;
}
